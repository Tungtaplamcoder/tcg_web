# =============================================================================
# Git Ignore for TCG E-Commerce Platform
# =============================================================================

# Dependencies
node_modules
*/node_modules

# Build outputs
dist
build
*.tsbuildinfo
*/dist
*/build

# Environment files (secrets!)
.env
.env.local
.env.*.local
*/.env
*/.env.local
*/.env.*.local

# Remote-ops credentials (LOCAL machine only — NEVER committed/uploaded)
.env.cpanel
*/.env.cpanel
.env.cpanel.deploy
*/.env.cpanel.deploy
# Generated cPanel artifacts
.env.generated
cpanel-env.generated
.env.bak
*/.env.bak
# SQL dumps produced by pack-cpanel.sh (seed.sql / seed-data.sql copies)
database/dump.sql
database/seed-data.sql
database/seed.sql

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDE/Editor
.idea
.vscode
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# OS
.DS_Store
Thumbs.db

# Git
.git

# Docker
.dockerignore

# Test coverage
coverage
.nyc_output
*.lcov

# Python
__pycache__/
*.pyc

# Prisma
prisma/migrations/.migration_lock.toml

# NOTE: the generated Prisma client (backend/src/generated/prisma, custom
# output — see backend/prisma/schema.prisma) is deliberately COMMITTED and
# shipped inside the deploy zip, so `prisma generate` never runs on the
# production server (cPanel LVE kills the CLI's Wasm validation with OOM).

# Uploads (runtime data)
uploads
public/uploads
backend/uploads

# Cache
.cache
.parcel-cache
.esbuild
.vite
.next
.nuxt
.output

# cPanel deploy artifact (built locally by pack-cpanel.sh)
deploy-cpanel.zip

# Database backups
backups
*/backups

# Misc
*.pem
*.key
*.crt
*.p12

# Turbo
.turbo

# Vercel
.vercel

# Netlify
.netlify

# TypeScript
*.tsbuildinfo