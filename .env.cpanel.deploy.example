# =============================================================================
# cPanel AUTOMATED DEPLOYMENT configuration — LOCAL machine only.
# =============================================================================
# Copy to .env.cpanel.deploy (git-ignored) and fill in real values:
#
#   cp .env.cpanel.deploy.example .env.cpanel.deploy
#
# Used by deploy_cpanel.py (and the provisioning phase of pack-cpanel.sh) to
# provision the database + user + privileges and auto-import the SQL dump with
# ZERO cPanel web-interface actions.
#
# NEVER commit or upload this file — it contains your API token.
# =============================================================================

# --- cPanel API access ------------------------------------------------------
# Host: your cPanel server hostname WITHOUT https:// (e.g. server123.host.com
# or your domain if cPanel runs on it).
CPANEL_HOST=server.example.com
CPANEL_PORT=2083
# The cPanel account username (also the DB name prefix).
CPANEL_USER=myacct

# Preferred: a cPanel API token (cPanel > Security > Manage API Tokens).
# Create two scopes: "MySQL" and (only if CPANEL_UPLOAD_ENV=1) "File Storage".
CPANEL_API_TOKEN=
# Fallback if no token: the account password (Basic auth).
CPANEL_PASSWORD=

# --- Database target --------------------------------------------------------
# Provide the SUFFIX or the full prefixed name; the account prefix is added
# automatically. Example: CPANEL_DB_NAME=tcgstore -> myacct_tcgstore
CPANEL_DB_NAME=tcgstore
CPANEL_DB_USER=tcg
# Leave empty to auto-generate a strong password (recommended). If the user
# already exists, the password is reset to this value automatically.
CPANEL_DB_PASS=

# --- SQL auto-import --------------------------------------------------------
# Host the `mysql` client connects to during auto-import.
#   localhost  -> run deploy_cpanel.py ON the cPanel server
#   <hostname> -> run from your machine (requires Remote MySQL whitelisting)
CPANEL_DB_HOST=localhost
CPANEL_DB_PORT=3306
# Set to 1 to re-import even when the database already contains tables.
CPANEL_FORCE_IMPORT=0

# --- Generated .env ---------------------------------------------------------
# Where the provisioned credentials are written (relative to repo root).
CPANEL_ENV_OUT=backend/.env
# Set to 1 to push the .env onto the account via Fileman::save_file_content.
CPANEL_UPLOAD_ENV=0
# App directory on the cPanel account (the Passenger app root).
CPANEL_APP_PATH=tcg/backend

# --- TLS --------------------------------------------------------------------
# Set to 1 for hosts with self-signed certificates (common on shared cPanel).
CPANEL_INSECURE=0
