generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum Role {
  CUSTOMER
  ADMIN
  MODERATOR
  STAFF
}

enum UserStatus {
  ACTIVE
  BANNED
  DELETED
}

enum OrderStatus {
  PENDING
  CANCELLED
  PACKAGING
  SHIPPING
  DELIVERED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  SEPAy
}

enum PaymentLogStatus {
  PENDING
  COMPLETED
  MISMATCH
  SIGNATURE_MISMATCH
  INVALID_PAYLOAD
  AMOUNT_MISMATCH
  DUPLICATE
  ERROR
}

enum CardCondition {
  MINT
  NEAR_MINT
  LIGHTLY_PLAYED
  MODERATELY_PLAYED
  HEAVILY_PLAYED
  EXCELLENT
  GOOD
  POOR
}

enum CardStatus {
  AVAILABLE
  RESERVED
  SOLD
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
  DELETED
}

enum ChatRoomStatus {
  OPEN
  CLOSED
}

enum MessageType {
  TEXT
  SYSTEM
}

enum VirtualBoxStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum GachaRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum UserCardSource {
  GACHA
  PURCHASE
  PROMOTION
}

// ==================== MODELS ====================

model User {
  id                 String     @id @default(uuid())
  email              String     @unique
  passwordHash       String
  fullName           String
  phone              String?
  address            String?
  avatarUrl          String?
  role               Role       @default(CUSTOMER)
  status             UserStatus @default(ACTIVE)
  emailVerified      Boolean    @default(false)
  canManageInventory Boolean    @default(false)
  canManagePosts     Boolean    @default(false)
  canAccessChat      Boolean    @default(false)
  balance            Decimal    @default(0) @db.Decimal(12, 2)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  orders               Order[]
  chatRooms            ChatRoom[]
  chatMessages         ChatMessage[]
  chatParticipants     ChatParticipant[]
  posts                Post[]
  userCards            UserCard[]
  virtualBoxOpenings   VirtualBoxOpening[]
}

model Post {
  id           String   @id @default(uuid())
  title        String
  content      String
  excerpt      String?
  thumbnailUrl String?
  authorId     String
  author       User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([authorId])
}

model RefreshToken {
  id              String   @id @default(uuid())
  token           String   @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt       DateTime
  revoked         Boolean  @default(false)
  replacedByToken String?
  createdByIp     String?
  createdAt       DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Set {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  releaseDate DateTime?
  description String?
  imageUrl    String?
  products    Product[] @relation("ProductSets")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id            String        @id @default(uuid())
  name          String
  shortName     String?
  slug          String        @unique
  description   String?
  cardNumber    String?
  rarity        String?
  artist        String?
  tcgplayerId   String?
  categoryId    String?
  category      Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sets          Set[]         @relation("ProductSets")
  images        String[]      @default([])
  backImage     String?
  attributes    Json?
  status        ProductStatus @default(ACTIVE)
  version       Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  variants      ProductVariant[]
  cards         Card[]
  orderItems    OrderItem[]

  @@index([categoryId])
  @@index([status])
  @@index([slug])
}

model ProductVariant {
  id            String        @id @default(uuid())
  productId     String
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  condition     CardCondition @default(NEAR_MINT)
  variant       String        @default("Normal")
  price         Decimal       @db.Decimal(10, 2)
  stockQuantity Int           @default(0)
  status        ProductStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  orderItems    OrderItem[]

  @@index([productId])
  @@index([condition])
  @@index([variant])
}

model Card {
  id            String        @id @default(uuid())
  sku           String        @unique
  productId     String
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  condition     CardCondition @default(NEAR_MINT)
  status        CardStatus    @default(AVAILABLE)
  purchasePrice Decimal?      @db.Decimal(10, 2)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  orderItems OrderItem[]

  @@index([productId])
  @@index([status])
  @@index([sku])
}

model Order {
  id              String        @id @default(uuid())
  orderCode       String        @unique
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  status          OrderStatus   @default(PENDING)
  totalAmount     Decimal       @db.Decimal(10, 2)
  shippingFee     Decimal       @default(0) @db.Decimal(10, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(10, 2)
  grandTotal      Decimal       @db.Decimal(10, 2)
  shippingAddress Json
  trackingNumber  String?
  paymentMethod   PaymentMethod @default(SEPAy)
  paymentStatus   PaymentStatus @default(PENDING)
  expiresAt       DateTime
  paidAt          DateTime?
  cancelledAt     DateTime?
  completedAt     DateTime?
  version         Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items         OrderItem[]
  payments      Payment[]
  paymentLogs   PaymentLog[]
  statusHistory OrderStatusHistory[]
  chatRoom      ChatRoom?

  @@index([userId])
  @@index([status])
  @@index([orderCode])
  @@index([expiresAt])
}

model OrderItem {
  id         String           @id @default(uuid())
  orderId    String
  order      Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId  String?
  variant    ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  cardId     String?
  card       Card?            @relation(fields: [cardId], references: [id], onDelete: SetNull)
  quantity   Int              @default(1)
  unitPrice  Decimal          @db.Decimal(10, 2)
  totalPrice Decimal          @db.Decimal(10, 2)
  createdAt  DateTime         @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@index([cardId])
}

model Payment {
  id                 String        @id @default(uuid())
  orderId            String
  order              Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod      PaymentMethod @default(SEPAy)
  amount             Decimal       @db.Decimal(10, 2)
  status             PaymentStatus @default(PENDING)
  sepayOrderCode     String?
  sepayTransactionId String?
  paymentUrl         String?
  qrCodeUrl          String?
  paidAt             DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  paymentLogs PaymentLog[]

  @@index([orderId])
  @@index([status])
}

model PaymentLog {
  id                 String           @id @default(uuid())
  sepayTransactionId String?          @unique
  orderId            String?
  order              Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  paymentId          String?
  payment            Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  rawPayload         Json
  amount             Decimal?         @db.Decimal(10, 2)
  content            String?
  status             PaymentLogStatus @default(PENDING)
  errorMessage       String?
  processedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([orderId])
  @@index([sepayTransactionId])
  @@index([status])
}

model OrderStatusHistory {
  id              String       @id @default(uuid())
  orderId         String
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  oldStatus       OrderStatus?
  newStatus       OrderStatus
  note            String?
  changedByUserId String?
  createdAt       DateTime     @default(now())

  @@index([orderId])
}

model ChatRoom {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderId   String?        @unique
  order     Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  subject   String
  status    ChatRoomStatus @default(OPEN)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  messages     ChatMessage[]
  participants ChatParticipant[]

  @@index([userId])
  @@index([status])
}

model ChatParticipant {
  id         String    @id @default(uuid())
  roomId     String
  room       ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([roomId])
  @@index([userId])
}

model ChatMessage {
  id          String      @id @default(uuid())
  roomId      String
  room        ChatRoom    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User        @relation(fields: [senderId], references: [id], onDelete: Restrict)
  content     String
  type        MessageType @default(TEXT)
  attachments String[]    @default([])
  isRead      Boolean     @default(false)
  readAt      DateTime?
  createdAt   DateTime    @default(now())

  @@index([roomId])
  @@index([senderId])
  @@index([createdAt])
}

// ==================== APP SETTINGS ====================

// Simple key-value store for admin-editable runtime configuration
// (e.g. SePay gateway settings that seed from .env defaults).
model AppSetting {
  key        String   @id
  value      String
  updatedAt  DateTime @updatedAt

  @@index([key])
}

// ==================== VIRTUAL BOXES (GACHA) ====================
// Fully decoupled from the retail Shop Inventory: gacha pools are made of
// dedicated GachaCard rows, never Product/Card (shop) rows.

// A collectible card that only exists inside the gacha ecosystem.
// Self-contained artwork/name/set metadata — nothing is inherited from
// the shop Product catalog.
model GachaCard {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  imageUrl  String?
  rarity    GachaRarity
  setCode   String?
  // Optional per-card weight used when a box pools cards of the same rarity
  // (0/null → uniform). Kept on the card so pools stay trivially simple.
  dropRate  Float        @default(1)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  poolItems    VirtualBoxPoolItem[]
  userCards    UserCard[]

  @@index([rarity])
  @@index([setCode])
}

model VirtualBox {
  id          String           @id @default(uuid())
  name        String
  slug        String           @unique
  description String?
  imageUrl    String?
  gradient    String?
  price       Decimal          @db.Decimal(10, 2)
  status      VirtualBoxStatus @default(DRAFT)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  dropRates VirtualBoxDropRate[]
  poolItems VirtualBoxPoolItem[]
  openings  VirtualBoxOpening[]

  @@index([status])
}

model VirtualBoxDropRate {
  id        String      @id @default(uuid())
  boxId     String
  box       VirtualBox  @relation(fields: [boxId], references: [id], onDelete: Cascade)
  rarity    GachaRarity
  rate      Float
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([boxId, rarity])
  @@index([boxId])
}

model VirtualBoxPoolItem {
  id         String     @id @default(uuid())
  boxId      String
  box        VirtualBox @relation(fields: [boxId], references: [id], onDelete: Cascade)
  gachaCardId String
  gachaCard  GachaCard  @relation(fields: [gachaCardId], references: [id], onDelete: Cascade)
  rarity     GachaRarity
  createdAt  DateTime   @default(now())

  @@unique([boxId, gachaCardId])
  @@index([boxId, rarity])
  @@index([gachaCardId])
}

model UserCard {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  gachaCardId String
  gachaCard  GachaCard      @relation(fields: [gachaCardId], references: [id], onDelete: Restrict)
  rarity     GachaRarity
  source     UserCardSource @default(GACHA)
  openingId  String?        @unique
  obtainedAt DateTime       @default(now())

  @@index([userId])
  @@index([gachaCardId])
  @@index([rarity])
}

model VirtualBoxOpening {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  boxId      String
  box        VirtualBox  @relation(fields: [boxId], references: [id], onDelete: Cascade)
  userCardId String?     @unique
  rarity     GachaRarity
  pricePaid  Decimal     @db.Decimal(10, 2)
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([boxId])
  @@index([createdAt])
}