# ============================================================================
# TCG E-Commerce — Backend PRODUCTION environment (runtime)
# ============================================================================
# Copy to backend/.env (or inject via docker-compose / orchestrator env).
# NEVER commit real secrets to version control.
# ============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=4000

# -----------------------------------------------------------------------------
# Database (MariaDB / MySQL — cPanel)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name
DATABASE_URL=mysql://your_db_user:your_db_password@localhost:3306/your_db_name
DB_POOL_LIMIT=5
DB_POOL_TIMEOUT=10
DATABASE_SSL_MODE=disable

# -----------------------------------------------------------------------------
# JWT Authentication (openssl rand -base64 32)
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_strong_access_secret
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Public domains — SePay callbacks, CORS, webhook resolution
# -----------------------------------------------------------------------------
# Primary production frontend domain. SePay redirects buyers back here after
# payment: ${NEXT_PUBLIC_APP_URL}/payment/success?orderId=...
# MUST be the real public domain — localhost is rejected in production.
NEXT_PUBLIC_APP_URL=https://yourdomain.com
# Backend API origin for server-to-server SePay IPN. Leave EMPTY when the API
# is served by the same Nginx domain under /api — the webhook URL is then
# derived from the incoming request Host/X-Forwarded-Host header.
NEXT_PUBLIC_API_URL=
# Extra CORS-allowed origins (comma-separated): www/non-www, admin panel, etc.
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# -----------------------------------------------------------------------------
# SePay Payment Gateway
# -----------------------------------------------------------------------------
SEPAY_API_URL=https://my.sepay.vn
SEPAY_ENV=production
SEPAY_MERCHANT_ID=your_production_merchant_id
SEPAY_MERCHANT_SECRET_KEY=your_production_secret_key
# Full webhook override (highest priority, optional):
# SEPAY_WEBHOOK_URL=https://yourdomain.com/api/v1/webhooks/sepay
SEPAY_WEBHOOK_SECRET=your_webhook_signature_secret
SEPAY_ACCOUNT_NUMBER=your_bank_account_number
SEPAY_ACCOUNT_NAME=your_bank_account_name

# -----------------------------------------------------------------------------
# Email (SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_HOSTNAME=yourdomain.com

# -----------------------------------------------------------------------------
# Admin seed user (created on first seed)
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace_with_strong_admin_password

# -----------------------------------------------------------------------------
# Image upload (ImgBB)
# -----------------------------------------------------------------------------
IMGBB_API_KEY=your_imgbb_api_key
