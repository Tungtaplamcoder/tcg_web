# =============================================================================
# Environment Configuration for TCG E-Commerce Backend
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control - it contains secrets!
#
# Two deployment targets use this file:
#   - LOCAL development:     DB_HOST=localhost (Docker MariaDB / local install)
#   - cPanel PRODUCTION:     values go into Setup Node.js App > Environment
#     variables (GUI) — see DEPLOY_CPANEL.md. The server-side .env is only a
#     dotenv fallback; the GUI env vars are authoritative.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development                    # development | production | test
PORT=4000                               # Server port (Passenger ignores this)

# -----------------------------------------------------------------------------
# Database (MariaDB / MySQL — cPanel compatible)
# -----------------------------------------------------------------------------
# All credentials come from these DB_* variables — NEVER hardcoded in source.
# cPanel: use the database name/user created in cPanel > MySQL Databases
# (usually prefixed like cpaneluser_tcg) and the cPanel hostname (usually
# "localhost" — the Node app connects from the SAME server).
DB_HOST=localhost                          # cPanel app: localhost (same-server DB)
DB_PORT=3306                               # MariaDB default port
DB_USER=your_db_user                       # cPanel: cpaneluser_tcguser
DB_PASS=your_db_password
DB_NAME=your_db_name                       # cPanel: cpaneluser_tcgdb
# Full connection string read by Prisma — must match the DB_* vars above.
# URL-ENCODE special characters in the password (@ -> %40, # -> %23, etc.).
DATABASE_URL=mysql://your_db_user:your_db_password@localhost:3306/your_db_name
# Connection pool — keep SMALL on cPanel shared hosting (entry processes are
# limited by LVE; a big pool exhausts MySQL connections for the whole account).
DB_POOL_LIMIT=5
DB_POOL_TIMEOUT=10

# -----------------------------------------------------------------------------
# Database SSL (cPanel: localhost connections normally need NO SSL)
# -----------------------------------------------------------------------------
# disable | require  (verify-ca/verify-full also need DATABASE_SSL_CA_PATH)
DATABASE_SSL_MODE=disable
# DATABASE_SSL_CA_PATH=./certs/ca.pem   # only for verify-* modes

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# Generate strong secrets: openssl rand -base64 32
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m               # Access token expiry (e.g., 15m, 1h, 4h)
JWT_REFRESH_EXPIRES_IN=7d               # Refresh token expiry (e.g., 7d, 30d)

# -----------------------------------------------------------------------------
# Public Domains (SePay callbacks, CORS, webhook resolution)
# -----------------------------------------------------------------------------
# RULES (applied by src/config/env.js):
#   - NO trailing slash — normalized automatically, but keep it clean anyway
#   - production ALWAYS https:// — never localhost/ngrok
#   - schema+host only — no path, no port (unless the app runs on a custom port)
#
# Primary production frontend domain — SePay redirects buyers back here:
#   ${NEXT_PUBLIC_APP_URL}/payment/success?orderId=...
NEXT_PUBLIC_APP_URL=https://yourdomain.com
# Backend API origin (server-to-server IPN resolves from this). Leave EMPTY
# when the API is served by the same domain under /api — the webhook URL is
# then derived from the incoming request Host header.
NEXT_PUBLIC_API_URL=
# Extra origins allowed by CORS (comma-separated, no trailing slashes):
# www/non-www variants, staging subdomains, LAN/testing IPs, etc.
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# -----------------------------------------------------------------------------
# SePay Payment Gateway
# -----------------------------------------------------------------------------
SEPAY_API_URL=https://my.sepay.vn       # SePay API base URL (keep as-is for production)
SEPAY_ENV=sandbox                       # sandbox | production
SEPAY_MERCHANT_ID=your_merchant_id      # From SePay dashboard
SEPAY_MERCHANT_SECRET_KEY=your_secret_key # From SePay dashboard

# Webhook / IPN URL — KHÔNG hardcode domain tunnel trong code.
# Thứ tự ưu tiên khi suy ra URL webhook:
#   1. Admin panel (/admin/sepay-config) — lưu vào AppSetting DB
#   2. SEPAY_WEBHOOK_URL bên dưới (URL đầy đủ)
#   3. NEXT_PUBLIC_API_URL + /api/v1/webhooks/sepay
#   4. Host header của request đến (khi chạy sau Nginx reverse proxy)
#   5. NEXT_PUBLIC_APP_URL + /api/v1/webhooks/sepay (cùng domain frontend)
# SEPAY_WEBHOOK_URL=https://yourdomain.com/api/v1/webhooks/sepay

# SePay settings hiển thị trong admin panel khi chưa có override trong DB
SEPAY_WEBHOOK_SECRET=your_webhook_secret  # Secret verify chữ ký IPN — PHẢI khớp
                                             # giá trị cấu hình trên my.sepay.vn.
                                             # Fallback: nếu để trống, hệ thống dùng
                                             # SEPAY_MERCHANT_SECRET_KEY để verify.
                                             # Chữ ký được chấp nhận nếu khớp MỘT
                                             # trong hai key này (không vỡ khi chỉ
                                             # đổi một bên trên dashboard).
SEPAY_ACCOUNT_NUMBER=                    # Số tài khoản ngân hàng nhận chuyển khoản
SEPAY_ACCOUNT_NAME=                     # Tên chủ tài khoản

# -----------------------------------------------------------------------------
# Email (SMTP) - For order notifications, password resets, etc.
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com                # SMTP server host
SMTP_PORT=587                           # SMTP port (587 for TLS, 465 for SSL)
SMTP_USER=your_email@gmail.com          # SMTP username
SMTP_PASS=your_app_password             # SMTP password / app password
SMTP_HOSTNAME=yourdomain.com            # Hostname for EHLO command (use your domain in production)

# -----------------------------------------------------------------------------
# Admin User (Created on first seed/migration)
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=StrongAdminPassword123!

# -----------------------------------------------------------------------------
# Image Upload (ImgBB) with local fallback
# -----------------------------------------------------------------------------
# If IMGBB_API_KEY is missing or the ImgBB request fails, the uploaded image is
# saved locally to backend/public/uploads/ and served at /uploads/<filename>.
IMGBB_API_KEY=your_imgbb_api_key        # Get from api.imgbb.com
