# Environment
NODE_ENV=development
PORT=4000

# Database (MariaDB / MySQL — cPanel compatible)
# Credentials are loaded from .env only — never hardcoded in source.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=tung123
DB_NAME=tcg_db
# Full connection string ( Prisma reads this ). Built from the DB_* vars above.
DATABASE_URL=mysql://root:tung123@127.0.0.1:3306/tcg_db
# Connection pool (cPanel shared hosting: keep small)
DB_POOL_LIMIT=5
DB_POOL_TIMEOUT=10

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=4h
JWT_REFRESH_EXPIRES_IN=30d

# SePay Payment Gateway
SEPAY_API_URL=https://my.sepay.vn
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=SP-TEST-LK2B88BA
SEPAY_MERCHANT_SECRET_KEY=spsk_test_9BMx25GEgQLDWqSo2f85vehZMjXpRGUq
# Webhook/IPN URL SePay gọi về — KHÔNG hardcode domain tunnel.
# Ưu tiên: AppSetting DB (admin panel) > SEPAY_WEBHOOK_URL > NEXT_PUBLIC_API_URL + path > Host header > NEXT_PUBLIC_APP_URL + path
# SEPAY_WEBHOOK_URL=https://your-domain.com/api/v1/webhooks/sepay
# SePay settings shown in the admin panel when no DB override exists.
# Saving in /admin/sepay-config persists overrides to the database.
SEPAY_WEBHOOK_SECRET=spsk_test_9BMx25GEgQLDWqSo2f85vehZMjXpRGUq
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
IMGBB_API_KEY=41b784761ea1f9de0330dc85dd14c7b3
# Frontend (dev server) — SePay return redirects + CORS
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://192.168.101.13

# Redis (optional for Socket.io scaling)
REDIS_URL=redis://localhost:6379

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@tcg.com
SMTP_PASS=change_me_email_password

# Initial Admin
ADMIN_EMAIL=admin@tcg.com
ADMIN_PASSWORD=Admin@123
