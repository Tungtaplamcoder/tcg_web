# ============================================================================
# TCG E-Commerce — Frontend PRODUCTION environment (Vite build-time)
# ============================================================================
# Copy to .env.production (Vite loads it automatically for production builds)
# or pass as Docker build args. Values are BAKED into the client bundle.
# NEVER put secrets here — everything is visible in the browser!
# ============================================================================

# -----------------------------------------------------------------------------
# Public application URL (frontend domain)
# -----------------------------------------------------------------------------
# Used for canonical URLs and absolute redirects. SePay's browser redirects
# (returnUrl/cancelUrl) are constructed server-side from the same variable.
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# -----------------------------------------------------------------------------
# API base URL
# -----------------------------------------------------------------------------
# Preferred: RELATIVE path — the browser requests whatever origin served the
# app and Nginx proxies /api/v1 to the backend. This works under any domain,
# including www/non-www, with zero CORS exposure.
# Use an absolute URL ONLY when the API lives on a separate origin
# (e.g., https://api.yourdomain.com/api/v1).
NEXT_PUBLIC_API_URL=/api/v1

# -----------------------------------------------------------------------------
# Socket.io origin (real-time chat/notifications)
# -----------------------------------------------------------------------------
# Empty = same origin as the page (proxied by Nginx at /socket.io/).
# Absolute only if the socket server is on a separate origin.
NEXT_PUBLIC_SOCKET_URL=
