# =============================================================================
# Environment Configuration for TCG E-Commerce Frontend (Vite)
# =============================================================================
# Copy this file to .env and fill in your actual values.
# Vite only exposes variables prefixed with VITE_ to the client bundle.
# NEVER put secrets in VITE_ variables - they are visible in the browser!
# =============================================================================

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# Backend API base URL. Preferred in production: RELATIVE path (/api/v1) so
# the browser goes through the Nginx reverse proxy under whatever domain
# serves the app (no CORS exposure). Absolute URL only when the API is on
# a separate origin (e.g., https://api.example.com/api/v1).
# Both NEXT_PUBLIC_* and VITE_* names are accepted (see vite.config.js).
NEXT_PUBLIC_API_URL=/api/v1
VITE_API_URL=/api/v1

# -----------------------------------------------------------------------------
# Socket.io Configuration
# -----------------------------------------------------------------------------
# WebSocket server URL for real-time features. Empty = same origin as the
# page (proxied by Nginx at /socket.io/).
NEXT_PUBLIC_SOCKET_URL=
VITE_SOCKET_URL=

# -----------------------------------------------------------------------------
# Development Proxy Targets (Only used in development)
# -----------------------------------------------------------------------------
# Backend target for Vite dev server proxy
VITE_API_PROXY_TARGET=http://localhost:4000
# Socket.io target for Vite dev server proxy
VITE_SOCKET_PROXY_TARGET=http://localhost:4000

# -----------------------------------------------------------------------------
# Frontend Application
# -----------------------------------------------------------------------------
# Public frontend URL (canonical URLs, absolute redirects). In production
# this is your real domain (e.g., https://yourdomain.com) — never localhost
# or a tunnel domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000
VITE_APP_URL=http://localhost:3000

# Frontend dev server port
VITE_PORT=3000

# -----------------------------------------------------------------------------
# Feature Flags (Optional)
# -----------------------------------------------------------------------------
# Enable/disable features for A/B testing or gradual rollout
VITE_ENABLE_CHAT=true
VITE_ENABLE_PAYMENT=true
VITE_ENABLE_WISHLIST=false