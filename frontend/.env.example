# =============================================================================
# Environment Configuration for TCG E-Commerce Frontend (Vite)
# =============================================================================
# Copy this file to .env and fill in your actual values.
# Vite only exposes variables prefixed with VITE_ to the client bundle.
# NEVER put secrets in VITE_ variables - they are visible in the browser!
# =============================================================================

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# Backend API base URL (without trailing slash)
# In development, Vite proxy handles /api requests (see vite.config.js)
# In production, set to your actual API domain (e.g., https://api.example.com)
VITE_API_URL=http://localhost:4000/api/v1

# -----------------------------------------------------------------------------
# Socket.io Configuration
# -----------------------------------------------------------------------------
# WebSocket server URL for real-time features (chat, notifications)
# In production, set to your actual WebSocket domain (e.g., wss://api.example.com)
VITE_SOCKET_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# Development Proxy Targets (Only used in development)
# -----------------------------------------------------------------------------
# Backend target for Vite dev server proxy
VITE_API_PROXY_TARGET=http://localhost:4000
# Socket.io target for Vite dev server proxy
VITE_SOCKET_PROXY_TARGET=http://localhost:4000

# -----------------------------------------------------------------------------
# Frontend Application
# -----------------------------------------------------------------------------
# Frontend URL (used for canonical URLs, sharing, etc.)
VITE_APP_URL=http://localhost:3000

# Frontend dev server port
VITE_PORT=3000

# -----------------------------------------------------------------------------
# Feature Flags (Optional)
# -----------------------------------------------------------------------------
# Enable/disable features for A/B testing or gradual rollout
VITE_ENABLE_CHAT=true
VITE_ENABLE_PAYMENT=true
VITE_ENABLE_WISHLIST=false